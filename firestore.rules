// Firestore Security Rules — Théâtre Tête-à-Tête
//
// Deploy via Firebase CLI:
//   firebase deploy --only firestore:rules
//
// Or paste into Firebase Console → Firestore → Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Users collection ─────────────────────────────────────────────────────
    // users/{uid} — profile document owned by the user.

    match /users/{uid} {

      // User can read their own profile; admin can read any profile.
      allow read: if isOwner(uid) || isAdmin();

      // User can create their own profile document, but ONLY with role='user'.
      // Prevents privilege escalation via create.
      allow create: if isOwner(uid)
        && request.resource.data.role == 'user';

      // User can update their own profile, but CANNOT change their role.
      // request.resource.data is the full document after the write —
      // so this check catches any attempt to set role to a different value.
      allow update: if isOwner(uid)
        && request.resource.data.role == resource.data.role;

      // Admin can update or delete any user document (including role changes).
      allow update, delete: if isAdmin();
    }

    // ── Bookings collection ──────────────────────────────────────────────────
    // bookings/{bookingId}

    match /bookings/{bookingId} {

      // User can read their own bookings (realtime subscription + one-off reads).
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      // ── Create ─────────────────────────────────────────────────────────────
      // Direct client writes are disabled. Bookings are created exclusively
      // via /api/create-booking (Vercel serverless function) using the Firebase
      // Admin SDK, which bypasses these rules. This prevents any client-side
      // price manipulation (e.g. totalAmount: 0 / 8 via DevTools or curl).
      allow create: if false;

      // ── Update (user — expiry only) ────────────────────────────────────────
      // A normal user may expire ONLY their own booking, ONLY when
      // paymentExpiresAt has already passed (server time), and ONLY by
      // transitioning paymentStatus → 'expired' and status → 'cancelled'.
      // No other fields may be touched.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.paymentStatus == 'awaiting_transfer'
        && resource.data.paymentExpiresAt < request.time
        && request.resource.data.paymentStatus == 'expired'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['paymentStatus', 'status', 'updatedAt']);

      // ── Admin ──────────────────────────────────────────────────────────────
      // Admin can read, update, and delete any booking without restriction.
      allow read, update, delete: if isAdmin();
    }

    // ── Stats collection ─────────────────────────────────────────────────────
    // stats/siteStats — публичный счётчик «N зрителей» на лендинге.
    //
    // Читать может кто угодно — число показывается всем.
    // Писать не может НИКТО из клиентов: счётчик увеличивает только
    // /api/register-audience через Admin SDK, ровно один раз на пользователя.
    // Раньше правило разрешало любому авторизованному слать +1, и счётчик можно
    // было накручивать в цикле, а также создавать произвольные stats/{id}.
    match /stats/{statsId} {
      allow read:  if true;
      allow write: if false;
    }

    // ── Служебные серверные коллекции ────────────────────────────────────────
    // Все они пишутся исключительно Admin SDK, который правила не проверяет.
    // Клиенту здесь не нужно ничего — ни читать, ни писать.
    //
    //   showCounters/{showId}      — точка сериализации транзакций бронирования
    //   loyaltyState/{uid}         — израсходованные бонусы лояльности
    //   idempotencyKeys/{key}      — защита от повторного создания брони
    //   rateLimits/{bucket}        — лимиты отправки писем
    //   audienceCounted/{uid}      — отметка, что зритель уже учтён в счётчике
    match /showCounters/{showId}    { allow read, write: if false; }
    match /loyaltyState/{uid}       { allow read, write: if false; }
    match /idempotencyKeys/{keyId}  { allow read, write: if false; }
    match /rateLimits/{bucket}      { allow read, write: if false; }
    match /audienceCounted/{uid}    { allow read, write: if false; }

  }
}

// Firestore Security Rules — Théâtre Tête-à-Tête
//
// Deploy via Firebase CLI:
//   firebase deploy --only firestore:rules
//
// Or paste into Firebase Console → Firestore → Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Users collection ─────────────────────────────────────────────────────
    // users/{uid} — profile document owned by the user.

    match /users/{uid} {

      // User can read their own profile; admin can read any profile.
      allow read: if isOwner(uid) || isAdmin();

      // User can create their own profile document, but ONLY with role='user'.
      // Prevents privilege escalation via create.
      allow create: if isOwner(uid)
        && request.resource.data.role == 'user';

      // User can update their own profile, but CANNOT change their role.
      // request.resource.data is the full document after the write —
      // so this check catches any attempt to set role to a different value.
      allow update: if isOwner(uid)
        && request.resource.data.role == resource.data.role;

      // Admin can update or delete any user document (including role changes).
      allow update, delete: if isAdmin();
    }

    // ── Bookings collection ──────────────────────────────────────────────────
    // bookings/{bookingId}

    match /bookings/{bookingId} {

      // User can read their own bookings (realtime subscription + one-off reads).
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      // ── Create ─────────────────────────────────────────────────────────────
      // User can create a booking for themselves, with strictly constrained
      // initial field values.  No privileged fields can be set on create.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid

        // Initial booking status must always be 'pending'.
        // 'confirmed', 'attended', 'cancelled' are admin-only transitions.
        && request.resource.data.status == 'pending'

        // paymentStatus can only be 'not_paid' (on_site) or 'awaiting_transfer'
        // (bank_transfer).  'paid' and 'expired' are admin/system transitions.
        && request.resource.data.paymentStatus in ['not_paid', 'awaiting_transfer']

        // paidAt must never be present on creation — it is set by admin only.
        && !('paidAt' in request.resource.data)

        // paymentExpiresAt rules:
        //   bank_transfer → must be present, must be a future timestamp.
        //   on_site        → must NOT be present.
        && (
          request.resource.data.paymentMethod == 'bank_transfer'
          ? (
              'paymentExpiresAt' in request.resource.data
              && request.resource.data.paymentExpiresAt is timestamp
              && request.resource.data.paymentExpiresAt > request.time
            )
          : !('paymentExpiresAt' in request.resource.data)
        );

      // ── Update (user — expiry only) ────────────────────────────────────────
      // A normal user may expire ONLY their own booking, ONLY when
      // paymentExpiresAt has already passed (server time), and ONLY by
      // transitioning paymentStatus → 'expired' and status → 'cancelled'.
      // No other fields may be touched.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.paymentStatus == 'awaiting_transfer'
        && resource.data.paymentExpiresAt < request.time
        && request.resource.data.paymentStatus == 'expired'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['paymentStatus', 'status', 'updatedAt']);

      // ── Admin ──────────────────────────────────────────────────────────────
      // Admin can read, update, and delete any booking without restriction.
      allow read, update, delete: if isAdmin();
    }

    // ── Stats collection ─────────────────────────────────────────────────────
    // stats/siteStats — public "N spectators" counter shown on the landing page.
    // Public read so anyone can see the number without signing in.
    // Writes are limited to authenticated users bumping audienceCount by
    // exactly +1 (new registration) so the counter can't be reset or inflated
    // from the client. The admin delete-user API decrements via the Admin SDK,
    // which bypasses these rules entirely.
    match /stats/{statsId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.audienceCount is int;

      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['audienceCount'])
        && request.resource.data.audienceCount == resource.data.audienceCount + 1;
    }

  }
}

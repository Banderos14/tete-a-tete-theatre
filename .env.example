# .env.example — безопасный шаблон переменных окружения.
#
# Что это такое:
#   Этот файл — пример того, какие переменные нужны для запуска проекта.
#   Здесь нет реальных ключей. Его можно (и нужно) коммитить в git.
#
# Как использовать:
#   1. Скопируй этот файл: cp .env.example .env
#   2. Заполни реальные значения в .env
#   3. Файл .env НЕ идёт в git (он в .gitignore)
#
# Для локального запуска с Vercel Serverless Functions:
#   npm install -g vercel && vercel login && vercel link
#   Заполни RESEND_API_KEY и EMAIL_FROM ниже
#   Запусти: vercel dev

# ── Firebase (frontend, с префиксом VITE_) ────────────────────────────────────
# Эти ключи видны в браузере — это нормально, Firebase защищён правилами Firestore.
# Найди значения в Firebase Console → Project Settings → Your apps → Web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# RESEND_API_KEY и EMAIL_FROM — секретные, только на сервере.
# В продакшене добавлять в Vercel Dashboard → Settings → Environment Variables.
# НЕ добавлять VITE_ префикс — иначе ключ попадёт в браузер!
RESEND_API_KEY=
EMAIL_FROM=

# ── Email endpoint (frontend) ──────────────────────────────────────────────────
# По умолчанию /api/send-email — работает на Vercel без дополнительной настройки.
# Менять только если используешь другой путь или сторонний бэкенд.
VITE_EMAIL_ENDPOINT=/api/send-email

# ── Public site URL (for QR codes) ────────────────────────────────────────────
# Используется при генерации QR-кодов в PDF-билетах.
# Без этой переменной QR будет указывать на window.location.origin —
# при разработке это localhost, что делает QR нерабочим на телефоне.
# В Vercel: Settings → Environment Variables → VITE_PUBLIC_SITE_URL
VITE_PUBLIC_SITE_URL=https://tete-a-tete-theatre.vercel.app

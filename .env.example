# Firebase (Frontend — expose with VITE_ prefix)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email endpoint (Frontend — defaults to /api/send-email, no need to set in production)
# Set this only if you need to override the default Vercel function path.
VITE_EMAIL_ENDPOINT=/api/send-email

# Email provider — Resend (Backend only — set in Vercel Dashboard, NOT in .env.local for production)
# Sign up at resend.com → Create API key → Add your sender domain
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Théâtre Tête-à-Tête <billets@yourdomain.fr>

# For local testing with vercel dev:
# 1. npm install -g vercel
# 2. vercel login
# 3. vercel link (first time)
# 4. Fill RESEND_API_KEY and EMAIL_FROM below
# 5. Run: vercel dev
# The /api/send-email endpoint will be available at localhost:3000/api/send-email
